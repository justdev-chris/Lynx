Roar "🐾 Searching for: " + __term

Set tempDir = getenv("TEMP")
If tempDir == "" {
    Set tempDir = "."
}
Set jsonFile = tempDir + "/packages.json"

Run "curl -L -o packages.json https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile "packages.json"
Set json = __file_content

KittyParseJSON json
Set count = __json_count
Set found = 0

For i = 0 To count - 1 {
    Set key = __json_keys[i]
    Set value = __json_values[i]
    
    # Look for package names (keys that end with .description or .latest)
    KittyCheckIfStringContains key ".description"
    If __result == 1 {
        # Extract package name from key (e.g., "packages.meowsys.description" → "meowsys")
        KittyReplaceString key ".description" ""
        Set pkgKey = __result
        KittyReplaceString pkgKey "packages." ""
        Set pkgName = __result
        
        KittyCheckIfStringContains pkgName __term
        If __result == 1 {
            Roar "📦 " + pkgName + " - " + value
            Set found = found + 1
        }
    }
}

If found > 0 {
    Roar ""
    Roar "📦 " + found + " result(s) found"
} Else {
    Roar "❌ No results found for '" + __term + "'"
}

Run "rm -f packages.json"