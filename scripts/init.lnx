Roar "🐾 Initializing Lynx project..."

Set projectName = __project_name
Set author = __author

If projectName == "" {
    Roar "❌ Usage: lynx init <project_name> [author]"
    Roar "⚠️ Project not created"
} Else {
    If author == "" {
        Set author = "Anonymous"
    }

    KittyWriteFile "lynx.toml" "[package]\nname = " + projectName + "\nversion = \"0.1.0\"\nauthors = [\"" + author + "\"]\ndescription = \"A Lynx project\"\n\n[dependencies]\n"

    Paw "src"
    Paw "libs"
    Paw "bin"

    KittyWriteFile "src/main.lnx" "Roar \"Hello from " + projectName + "!\"\n"

    Roar "✅ Project '" + projectName + "' initialized. Run 'lynx build' next."
}
