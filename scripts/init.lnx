Roar "🐾 Initializing Lynx project..."

# ===== MAXIMUM DEBUGGING =====
Roar "=== DEBUG: __project_name = " + __project_name
Roar "=== DEBUG: __author = " + __author

Set projectName = __project_name
Set author = __author

Roar "=== DEBUG: projectName = " + projectName
Roar "=== DEBUG: author = " + author

If projectName == "" {
    Roar "❌ Usage: lynx init <project_name> [author]"
    Roar "⚠️ Project not created"
} Else {
    Roar "=== DEBUG: projectName is not empty, continuing..."
    
    Set projectDir = projectName
    Roar "=== DEBUG: projectDir = " + projectDir
    
    Paw projectDir
    Roar "=== DEBUG: Paw projectDir completed"
    
    Set srcPath = projectName + "/src"
    Set libsPath = projectName + "/libs"
    Set binPath = projectName + "/bin"
    Set tomlPath = projectName + "/lynx.toml"
    Set mainPath = projectName + "/src/main.lnx"
    
    Roar "=== DEBUG: srcPath = " + srcPath
    Roar "=== DEBUG: libsPath = " + libsPath
    Roar "=== DEBUG: binPath = " + binPath
    Roar "=== DEBUG: tomlPath = " + tomlPath
    Roar "=== DEBUG: mainPath = " + mainPath
    
    Paw srcPath
    Paw libsPath
    Paw binPath
    
    Set tomlContent = "[package]\n"
    Set tomlContent = tomlContent + "name = \""
    Set tomlContent = tomlContent + projectName
    Set tomlContent = tomlContent + "\"\n"
    Set tomlContent = tomlContent + "version = \"0.1.0\"\n"
    Set tomlContent = tomlContent + "authors = [\""
    Set tomlContent = tomlContent + author
    Set tomlContent = tomlContent + "\"]\n"
    Set tomlContent = tomlContent + "description = \"A Lynx project\"\n"
    Set tomlContent = tomlContent + "\n[dependencies]\n"

    KittyWriteFile tomlPath tomlContent

    Set mainContent = "Roar \"Hello from "
    Set mainContent = mainContent + projectName
    Set mainContent = mainContent + "!\"\n"
    KittyWriteFile mainPath mainContent

    Roar "✅ Project '" + projectName + "' initialized. Run 'lynx build' next."
}