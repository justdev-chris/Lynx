Roar "🐾 Removing package..."

If __pkg == "" Then
    Roar "❌ No package name provided."
    Exit
End

Set pkg = __pkg
Roar "🔧 Removing '" + pkg + "'..."

# Read TOML
Set toml = KittyReadFile "lynx.toml"
Set newToml = ""

Loop line in toml
    If line Contains pkg Then
        Roar "🗑️ Removing dependency line: " + line
    Else
        Set newToml = newToml + line + "\n"
    End
End

KittyWriteFile "lynx.toml" newToml

# Remove from lockfile
Set lock = KittyReadFile "lynx.lock"
Set newLock = ""

Loop line in lock
    If line Contains pkg Then
        Roar "🗑️ Removing lock entry: " + line
    Else
        Set newLock = newLock + line + "\n"
    End
End

KittyWriteFile "lynx.lock" newLock

Roar "✅ Package '" + pkg + "' removed successfully."
Exit
