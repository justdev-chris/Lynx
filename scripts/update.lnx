Roar "🐾 Updating packages..."

Set tempDir = getenv("TEMP")
If tempDir == "" {
    Set tempDir = "."
}
Set jsonFile = tempDir + "/packages.json"

Run "curl -L -o packages.json https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile "packages.json"
Set json = __file_content

KittyParseJSON json
Set json_count = __json_count

KittyReadFile "lynx.toml"
Set content = __file_content
KittySplitString content "\n"
Set lines = __result
Set lines_count = __result_count
Set in_deps = 0
Set new_toml = ""
Set updated = 0

For i = 0 To lines_count - 1 {
    Set line = lines[i]

    KittyCheckIfStringContains line "[dependencies]"
    If __result == 1 {
        in_deps = 1
        new_toml = new_toml + line + "\n"
        Continue
    }

    If in_deps == 1 {
        If line == "" {
            new_toml = new_toml + line + "\n"
            Continue
        }
        KittyCheckIfStringContains line "["
        If __result == 1 {
            in_deps = 0
            new_toml = new_toml + line + "\n"
            Continue
        }

        KittySplitString line "="
        If __result_count >= 2 {
            Set pkg = Trim(__result[0])
            Set old_version = Trim(__result[1])
            
            # Copy pkg BEFORE calling KittySplitString again
            Set pkgCopy = pkg
            
            # Remove quotes from old_version
            KittySplitString old_version "\""
            If __result_count >= 2 {
                Set old_version = __result[1]
            }
            
            # Find the package in the JSON using __json_keys and __json_values
            Set found_version = ""
            Set latest_key = "packages." + pkgCopy + ".latest"
            
            For j = 0 To json_count - 1 {
                If __json_keys[j] == latest_key {
                    Set found_version = __json_values[j]
                    Break
                }
            }

            If Len(found_version) > 0 {
                Roar "📦 Updating " + pkgCopy + " (" + old_version + " → " + found_version + ")"
                new_toml = new_toml + pkgCopy + " = \"" + found_version + "\"\n"
                Set updated = updated + 1
            } Else {
                Roar "⚠️ " + pkgCopy + " not found in registry, keeping " + old_version
                new_toml = new_toml + line + "\n"
            }
        }
    } Else {
        new_toml = new_toml + line + "\n"
    }
}

KittyWriteFile "lynx.toml" new_toml

If updated > 0 {
    Roar "🔄 Reinstalling updated packages..."
    Run "lynx install"
    Roar "✅ Updated " + updated + " package(s)"
} Else {
    Roar "✅ All packages up to date"
}

Run "rm -f packages.json"